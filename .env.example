# All optional. The app uses FPL's public API, so no login is needed.
# Your team ID, so the CLI doesn't need --manager-id (the dashboard pre-fills it too).
# It's the number in your Points page link: fantasy.premierleague.com/entry/<ID>/event/…
FPL_MANAGER_ID=
FPL_DB=fpl_agent.db
# Folder for per-team memory files (<team id>.json).
FPL_MEMORY_DIR=memory
FPL_HORIZON=6
# Free transfers and bank are worked out from public data. Uncomment only to override.
# FPL_FREE_TRANSFERS=1
# FPL_BANK=0.5
